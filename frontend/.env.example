# Frontend environment template.
#
# Copy this file to the env file for the mode you want, then set your backend URL:
#   - .env.production  -> baked into `npm run build` (already committed as a template)
#   - .env.local       -> overrides any mode; git-ignored, good for a local dev box
#                         pointed at a remote backend
#
# Vite only exposes variables prefixed with `VITE_`. This value is read by
# `src/lib/apiBase.ts` and prefixed onto every /api request. It must NOT have a
# trailing slash.
#
# Leave it empty/unset for same-origin relative URLs, which is what the Vite dev
# proxy in `vite.config.ts` expects (it forwards /api -> http://localhost:8000).

# Base URL of the backend, e.g. https://api.your-domain.com
VITE_API_BASE_URL=
